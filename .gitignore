# Binaries
/bin/
/dist/
quetzal-apiserver
quetzal-controller
quetzal-sftp
# bare `go build ./cmd/<x>` outputs at the repo root
/sftp
/configrender
/activator
*.exe

# Local data / DB
*.db
*.db-journal
*.sqlite
data/

# Go
/vendor/

# Node / frontend
web/node_modules/
# Built UI is embedded at build time but not committed; keep the dir via .gitkeep
# so `go build` (which embeds web/dist) works without a frontend build.
web/dist/*
!web/dist/.gitkeep

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Secrets / local config
*.local.yaml
kubeconfig

# Python bytecode (hack/ scripts)
__pycache__/
*.pyc

# Docs site: dependencies, build output, and what scripts/sync-docs.mjs
# generates from the repository's Markdown (hand-written pages are .mdx).
/website/node_modules/
/website/dist/
/website/.astro/
/website/src/content/docs/*.md
/website/src/assets/
/website/public/
