---
import { Icon } from '@astrojs/starlight/components';

const t = Astro.locals.t;
const messages = {
	loading: t('search.loading'),
	empty: t('search.empty', { term: '[TERM]' }),
	result: t('search.result', { term: '[TERM]' }),
	results: t('search.results', { term: '[TERM]', total: '[COUNT]' }),
	failure: t('search.failure'),
};
---

<quetzal-search class={Astro.props.class} data-messages={JSON.stringify(messages)}>
	<button data-open disabled aria-label={t('search.label')} aria-keyshortcuts="Control+K Meta+K">
		<Icon name="magnifier" /><span>{t('search.label')}</span>
	</button>
	<dialog aria-label={t('search.label')}>
		<div class="search-heading">
			<label for="quetzal-search-input">{t('search.label')}</label>
			<button data-close>{t('search.cancelLabel')}</button>
		</div>
		{import.meta.env.DEV ? <p>{t('search.devWarning')}</p> : (
			<>
				<input id="quetzal-search-input" type="search" autocomplete="off" aria-controls="quetzal-search-results" />
				<p data-status role="status" aria-live="polite" />
				<button data-retry hidden>{t('search.retry')}</button>
				<ul id="quetzal-search-results" />
				<button data-more hidden>{t('search.more')}</button>
			</>
		)}
	</dialog>
</quetzal-search>

<script>
	type Fragment = { url: string; meta: { title?: string }; excerpt: string; sub_results: { url: string; title: string; excerpt: string }[] };
	type Result = { data: () => Promise<Fragment> };
	type SearchIndex = { search: (term: string) => Promise<{ results: Result[] }>; destroy: () => Promise<void> };

	class QuetzalSearch extends HTMLElement {
		connectedCallback() {
			const dialog = this.querySelector('dialog')!;
			const open = this.querySelector<HTMLButtonElement>('[data-open]')!;
			const input = this.querySelector<HTMLInputElement>('input');
			const status = this.querySelector<HTMLElement>('[data-status]');
			const retry = this.querySelector<HTMLButtonElement>('[data-retry]')!;
			const more = this.querySelector<HTMLButtonElement>('[data-more]')!;
			const list = this.querySelector('ul')!;
			const messages = JSON.parse(this.dataset.messages!);
			let index: SearchIndex | undefined;
			let results: Result[] = [];
			let shown = 0;
			let revision = 0;
			let timer: ReturnType<typeof setTimeout>;
			// Serialize searches and resets: Pagefind retains rejected metadata/chunk promises.
			// A retry must destroy the failed instance, not reuse that cached rejection.
			let pending = Promise.resolve();

			const openModal = () => {
				dialog.showModal();
				document.body.setAttribute('data-search-modal-open', '');
				input?.focus();
			};
			open.addEventListener('click', openModal);
			open.disabled = false;
			this.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
			dialog.addEventListener('click', (event) => {
				if (event.target === dialog) {
					const box = dialog.getBoundingClientRect();
					if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) dialog.close();
				}
				if ((event.target as Element).closest('a')) dialog.close();
			});
			dialog.addEventListener('close', () => {
				document.body.removeAttribute('data-search-modal-open');
				open.focus();
			});
			const shortcuts = (event: KeyboardEvent) => {
				if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
					event.preventDefault();
					dialog.open ? dialog.close() : openModal();
				}
			};
			window.addEventListener('keydown', shortcuts);
			if (!input || !status) return;

			const text = (template: string, term: string, count = 0) => template.replace('[COUNT]', String(count)).replace('[TERM]', () => term);
			const appendLink = (parent: HTMLElement, url: string, title: string, excerpt: string) => {
				const link = document.createElement('a');
				link.href = url;
				link.textContent = title;
				const summary = document.createElement('p');
				// Read Pagefind's excerpt markup as text, without injecting HTML.
				summary.textContent = new DOMParser().parseFromString(excerpt, 'text/html').body.textContent;
				parent.append(link, summary);
			};
			const loadPage = async (id: number) => {
				const page = await Promise.all(results.slice(shown, shown + 5).map((result) => result.data()));
				if (id !== revision) return;
				for (const result of page) {
					const item = document.createElement('li');
					appendLink(item, result.url, result.meta.title || result.url, result.excerpt);
					for (const sub of result.sub_results || []) {
						if (sub.url === result.url) continue;
						const section = document.createElement('div');
						section.className = 'search-section';
						appendLink(section, sub.url, sub.title, sub.excerpt);
						item.append(section);
					}
					list.append(item);
				}
				shown += page.length;
				more.hidden = shown >= results.length;
			};
			const fail = async (error: unknown, id: number) => {
				console.error('Quetzal search failed:', error);
				if (id === revision) {
					status.textContent = messages.failure;
					list.replaceChildren();
					retry.hidden = false;
					more.hidden = true;
				}
				const failed = index;
				index = undefined;
				try { await failed?.destroy(); }
				catch (cleanupError) { console.error('Quetzal search reset failed:', cleanupError); }
			};
			const search = () => {
				clearTimeout(timer);
				const id = ++revision;
				const term = input.value.trim();
				retry.hidden = more.hidden = true;
				list.replaceChildren();
				status.textContent = term ? messages.loading : '';
				if (!term) return;
				pending = pending.then(async () => {
					if (id !== revision) return;
					try {
						if (!index) {
							const bundle = new URL(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/pagefind/`, location.origin);
							const pagefind = await import(/* @vite-ignore */ `${bundle}pagefind.js`);
							index = pagefind.createInstance({ basePath: bundle.href, baseUrl: import.meta.env.BASE_URL });
						}
						const response = await index!.search(term);
						if (id !== revision) return;
						results = response.results;
						shown = 0;
						await loadPage(id);
						if (id === revision) status.textContent = text(results.length === 1 ? messages.result : results.length ? messages.results : messages.empty, term, results.length);
					} catch (error) { await fail(error, id); }
				});
			};
			input.addEventListener('input', () => {
				++revision;
				clearTimeout(timer);
				timer = setTimeout(search, 200);
			});
			input.addEventListener('keydown', (event) => { if (event.key === 'Enter') search(); });
			retry.addEventListener('click', () => { search(); input.focus(); });
			more.addEventListener('click', () => {
				const id = revision;
				more.disabled = true;
				pending = pending.then(async () => {
					try { await loadPage(id); } catch (error) { await fail(error, id); }
					finally { more.disabled = false; }
				});
			});
		}
	}
	customElements.define('quetzal-search', QuetzalSearch);
</script>

<style>
	quetzal-search { display: contents; }
	:global(body[data-search-modal-open]) { overflow: hidden; }
	button, input { font: inherit; }
	button { cursor: pointer; color: var(--sl-color-white); background: var(--sl-color-bg); border: 1px solid var(--sl-color-gray-4); border-radius: 0.375rem; padding: 0.5rem 0.75rem; }
	button:focus-visible, input:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 2px; }
	[data-open] { display: flex; align-items: center; gap: 0.5rem; }
	dialog { color: var(--sl-color-text); background: var(--sl-color-bg); border: 1px solid var(--sl-color-gray-4); border-radius: 0.5rem; width: min(40rem, calc(100% - 2rem)); max-height: calc(100% - 2rem); padding: 1rem; margin: auto; }
	dialog::backdrop { background: var(--sl-color-backdrop-overlay); backdrop-filter: blur(0.25rem); }
	.search-heading { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
	input { width: 100%; color: var(--sl-color-white); background: var(--sl-color-gray-6); border: 1px solid var(--sl-color-gray-4); border-radius: 0.375rem; padding: 0.75rem; }
	[data-status] { margin-block: 1rem; }
	ul { list-style: none; padding: 0; }
	ul :global(li) { border-top: 1px solid var(--sl-color-gray-5); padding-block: 1rem; }
	ul :global(a) { color: var(--sl-color-text-accent); font-weight: 600; }
	ul :global(p) { margin: 0.25rem 0 0.75rem; }
	ul :global(.search-section) { border-inline-start: 1px solid var(--sl-color-gray-5); padding-inline-start: 1rem; }
	@media (max-width: 49.99rem) { [data-open] { border: 0; background: transparent; padding: 0.5rem; } [data-open] span { display: none; } }
</style>
